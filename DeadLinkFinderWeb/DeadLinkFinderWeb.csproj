<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHubRepoFinder\GitHubRepoFinder.csproj" />
    <ProjectReference Include="..\Telemetry\TelemetryLib.csproj" />
    <ProjectReference Include="..\WebsiteLinksChecker\LinksChecker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\images\" />
  </ItemGroup>

  <!-- Build Vue SPA before ASP.NET build (only in Release mode) -->
  <Target Name="BuildVueSPA" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Text="Installing Vue dependencies..." Importance="high" />
    <Exec Command="npm install" WorkingDirectory="..\VueUi" />
    
    <Message Text="Building Vue SPA..." Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="..\VueUi" />
  </Target>

  <!-- Ensure Vue build files are included in publish -->
  <Target Name="PublishVueSPA" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <DistFiles Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
